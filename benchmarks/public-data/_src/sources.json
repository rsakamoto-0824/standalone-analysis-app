      "format": "slump_csv",
      "inputs": [
        "Cement",
        "Slag",
        "FlyAsh",
        "Water",
        "SP",
        "CoarseAggregate",
        "FineAggregate"
      ],
      "objectives": [
        [
          "Slump_cm",
          "max"
        ],
        [
          "Flow_cm",
          "max"
        ],
        [
          "CompressiveStrength_MPa",
          "max"
        ]
      ],
      "expected_rows": 103,
      "citation": "I-Cheng Yeh (2007), Concrete Slump Test, UCI, doi:10.24432/C5FG7D.",
      "notes": "成分量はkg/m^3、Slump/Flowはcm、28日圧縮強度はMPa。3値の最大化は動作比較用の設定であり、実務ではSlump/Flowに目標範囲を設ける。元のNo列は測定IDなので入力から除いた。配合量の独立な連続変更を推奨するデータではない。",
      "source_sha256": "68d6a6813261bf8ecf79d8d7cc82b665bd5e9e6800c7705a16e671688c78e491"
